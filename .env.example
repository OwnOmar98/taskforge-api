# Copy to .env (gitignored) and fill in your own dev-scoped DO Spaces values.
# Never put the prod deploy credential here.
#
# Spring doesn't load .env files automatically - source this into your shell
# before running the app with the dev profile, e.g.:
#   set -a && source .env && set +a
# or use your IDE's env-file support for the run configuration.

DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
